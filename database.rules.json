{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usersByEmail": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "rooms": {
      "global": {
        "messages": {
          ".read": "auth != null",
          "$messageId": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid"
          }
        }
      }
    },
    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$contactUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $contactUid)"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $uid)"
        }
      }
    },
    "privateRooms": {
      "$roomId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && root.child('privateRooms').child($roomId).child('members').child(auth.uid).val() === true && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}
